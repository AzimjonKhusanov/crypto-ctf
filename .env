# NullCTF — Muhit o'zgaruvchilari namunasi
# Bu faylni .env deb nusxalab, qiymatlarni o'zgartiring

# Flask maxfiy kalit (kamida 32 tasodifiy belgi)
SECRET_KEY=your-super-secret-key-change-this-to-random-string

# Admin foydalanuvchi nomi
ADMIN_USERNAME=admin

# Admin paroli (bcrypt hash)
# Hash yaratish uchun:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SizningParolingiz'))"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$lmTse2rAtafn8L1p$e8bc3ac42cc90f7526b8f785c70ade295e6cb6e1a738653d53721e915b87e27899898985721631dd03a7b69a8ed0be845b530c90d260ed4a09074a92e592e4e8

# Ma'lumotlar bazasi (SQLite)
DATABASE_URL=sqlite:///nullctf.db

# Flask rejimi (development yoki production)
FLASK_ENV=production
